# Local development only. Replace passwords and keys outside local environments.
POSTGRES_DB=octapoint_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/octapoint_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-local

REDIS_HOST=redis
REDIS_PORT=6379

# Generate a unique 32-byte key per environment; Base64-encoded value accepted.
API_KEY_MASTER_KEY=change-me-local
API_KEY_ADMIN_TOKEN=change-me-local-admin-token
SPRING_PROFILES_ACTIVE=prod

# The example values above are placeholders. Generate a 32-byte random key and strong tokens before use.