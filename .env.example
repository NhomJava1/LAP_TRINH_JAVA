# Local development only. Replace passwords and keys outside local environments.
POSTGRES_DB=octapoint_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/octapoint_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-local

REDIS_HOST=redis
REDIS_PORT=6379

# 32-byte key for AES-256-GCM encryption of merchant API secrets
API_KEY_MASTER_KEY=change-me-local-32-byte-aes-key!
API_KEY_ADMIN_TOKEN=change-me-local-admin-token
JWT_SECRET=octapoint-local-dev-jwt-secret-key-2026!!
SPRING_PROFILES_ACTIVE=prod

# Settlement mode: LIVE (uses Sui Signer) or MOCK
SETTLEMENT_MODE=LIVE
SIGNER_BASE_URL=http://signer:3001
SIGNER_SERVICE_TOKEN=replace-with-random-internal-token

# The example values above are placeholders. Generate strong secrets before production use.
