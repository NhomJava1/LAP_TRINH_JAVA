@startuml OctaPoint_Issue_Activity
skinparam shadowing false
skinparam defaultFontName Arial
title OctaPoint - Issue Activity

|SDK|
start
:Nhận yêu cầu issue\n(customerId, orderId, amountVnd);
:Tạo Idempotency-Key,\ntimestamp, nonce và HMAC headers;

|HMAC Filter|
:Kiểm tra rate limit theo IP;
if (Vượt rate limit?) then (có)
  :Trả HTTP 429 RATE_LIMITED;
  |SDK|
  :Trả lỗi cho Merchant System;
  stop
else (không)
  :Kiểm tra API key, timestamp ±300s\nvà chữ ký HMAC-SHA256;
endif

if (Thông tin xác thực hợp lệ?) then (không)
  :Trả HTTP 401 Unauthorized;
  |SDK|
  :Trả lỗi xác thực;
  stop
else (có)
endif

|Redis|
:SETNX nonce với TTL 600s;
if (Nonce đã tồn tại hoặc Redis lỗi?) then (có)
  |HMAC Filter|
  :Trả HTTP 401 NONCE_REUSED\nhoặc lỗi xác thực;
  |SDK|
  :Trả lỗi chống replay;
  stop
else (không)
endif

|HMAC Filter|
:Kiểm tra scope ISSUE;
if (Thiếu scope?) then (có)
  :Trả HTTP 403 FORBIDDEN_SCOPE;
  |SDK|
  :Trả lỗi quyền hạn;
  stop
else (không)
endif

|Core Service|
:Kiểm tra tenant APPROVED;
if (Tenant chưa được duyệt/đang khóa?) then (có)
  :Trả HTTP 403 TENANT_NOT_APPROVED;
  |SDK|
  :Trả lỗi tenant;
  stop
else (không)
endif

|PostgreSQL|
:Tra cứu Idempotency-Key\nvà request hash;
if (Key đã tồn tại?) then (có)
  if (Hash giống nhau?) then (có)
    :Đọc response đã lưu;
    |Core Service|
    :Trả lại kết quả cũ;
    |SDK|
    :Nhận HTTP 200 (idempotent replay);
    stop
  else (không)
    |Core Service|
    :Trả HTTP 409 IDEMPOTENCY_CONFLICT;
    |SDK|
    :Nhận lỗi xung đột;
    stop
  endif
else (chưa)
endif

|Core Service|
:Bắt đầu xử lý giao dịch nghiệp vụ;
|PostgreSQL|
:Đọc rule đang hiệu lực,\ntính số điểm;
:Tạo customer nếu chưa tồn tại;
:Cộng balance và cấp chain_seq;
:Ghi ledger_entry;
:Ghi outbox_event PENDING\nvà idempotency response;
:COMMIT transaction;

|Core Service|
:Tạo kết quả nghiệp vụ;
|HMAC Filter|
:Trả HTTP 201 Created\n{points, balanceAfter,\nsettlementStatus: PENDING};
|SDK|
:Trả kết quả issue cho Merchant System;
stop
@enduml
